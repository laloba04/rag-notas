# Copia este archivo como .env y ajústalo. Nunca subas el .env al repositorio.

# Proveedor del LLM: ollama (por defecto, en local) o groq (por API: los fragmentos salen de tu red).
LLM_PROVEEDOR=ollama
# Modelo (obligatorio): el nombre depende del proveedor.
LLM_MODELO=qwen2.5:14b

# Solo con LLM_PROVEEDOR=ollama. Dirección del servidor: el propio equipo, u otro de tu red con GPU.
OLLAMA_URL=http://localhost:11434

# Solo con LLM_PROVEEDOR=groq. La clave se crea en https://console.groq.com/keys
# Ejemplo de modelo: LLM_MODELO=openai/gpt-oss-120b (lista en https://console.groq.com/docs/models)
# GROQ_API_KEY=
# Con un proveedor externo solo se envían fragmentos públicos: si hubiera alguno restringido, no se
# envía nada y salta un error (fijo en config.py, no se cambia desde aquí).

# LLM juez para evaluar las respuestas (opcional). Sin estas líneas es el mismo que el principal.
# Si pones el proveedor, el modelo es obligatorio.
# LLM_JUEZ_PROVEEDOR=groq
# LLM_JUEZ_MODELO=openai/gpt-oss-120b

# Opcionales (valores por defecto en config.py)
# LLM_TEMPERATURA=0.1
# TIMEOUT_LLM_S=120
# METODO_EVALUACION=reranker   # o "llm" (LLM juez sí/no por chunk)
# UMBRAL_RERANKER=0.5
# FICHERO_TRAZAS=logs/trazas.jsonl

# API web (api.py). Opcionales; el acceso de la API es siempre "publico" y no se configura aquí.
# CORS_ORIGENES=http://localhost:4200   # orígenes del frontend, separados por comas ("*" se ignora)
# LIMITE_POR_MINUTO=10                  # peticiones por minuto y por IP a /buscar y /preguntar
# LIMITE_PREGUNTAS_DIA=200              # tope diario de /preguntar para todo el servidor
# PROXIES_DE_CONFIANZA=                 # IP de los proxies cuyo X-Forwarded-For se cree
# TIMEOUT_PETICION_S=180
# CARGAR_MODELOS_AL_ARRANCAR=false     # true en el despliegue: carga los modelos al arrancar
