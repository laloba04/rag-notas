# Copia este archivo como .env y ajústalo.

# Proveedor y modelo del LLM (obligatorios). Proveedores soportados: ollama
LLM_PROVEEDOR=ollama
LLM_MODELO=qwen2.5:14b

# Dirección del servidor de Ollama: el propio equipo, u otro de tu red con GPU.
OLLAMA_URL=http://localhost:11434

# Opcionales (valores por defecto en config.py)
# LLM_TEMPERATURA=0.1
# TIMEOUT_LLM_S=120
# METODO_EVALUACION=reranker   # o "llm" (LLM juez sí/no por chunk)
# UMBRAL_RERANKER=0.5
# FICHERO_TRAZAS=logs/trazas.jsonl
