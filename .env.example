# Copia este archivo como .env y ajústalo. Nunca subas el .env al repositorio.

# Proveedor del LLM: ollama (por defecto, en local) o groq (por API: los fragmentos salen de tu red).
LLM_PROVEEDOR=ollama
# Modelo (obligatorio): el nombre depende del proveedor.
LLM_MODELO=qwen2.5:14b

# Solo con LLM_PROVEEDOR=ollama. Dirección del servidor: el propio equipo, u otro de tu red con GPU.
OLLAMA_URL=http://localhost:11434

# Solo con LLM_PROVEEDOR=groq. La clave se crea en https://console.groq.com/keys
# Ejemplo de modelo: LLM_MODELO=qwen/qwen3.8-27b (lista en https://console.groq.com/docs/models)
# GROQ_API_KEY=

# Opcionales (valores por defecto en config.py)
# LLM_TEMPERATURA=0.1
# TIMEOUT_LLM_S=120
# METODO_EVALUACION=reranker   # o "llm" (LLM juez sí/no por chunk)
# UMBRAL_RERANKER=0.5
# FICHERO_TRAZAS=logs/trazas.jsonl
